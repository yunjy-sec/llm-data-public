{
  "local": {
    "url": "ws://localhost:29282",
    "request": {
      "rqtype": "getknoxsso",
      "token": "",
      "data": "KCC10TRAY0153"
    },
    "response": {
      "userInfo": "data.userInfo",
      "key": "data.key"
    },
    "etc": {
      "설명": "1단계. 브라우저가 사용자 PC의 KnoxTray에 웹소켓으로 붙어 SSO 토큰을 받는다.",
      "url": "여기서 localhost는 서버가 아니라 사용자 PC다. 그래서 이 단계는 브라우저만 할 수 있다. 이 주소는 그대로 localhost로 둔다.",
      "request": "KnoxTray로 보낼 메시지. 적은 key와 value가 그대로 JSON으로 나간다.",
      "response": "받은 메시지에서 값을 꺼낼 경로. 경로 중간이 JSON 문자열이면 자동으로 한 번 파싱하고 계속 내려간다. KnoxTray는 data가 JSON 문자열이라 data.userInfo로 적는다.",
      "response 확인": "실제 응답 모양은 브라우저 콘솔의 [sso] local agent 줄에 message로 찍힌다. 경로가 다르면 그걸 보고 맞춘다.",
      "userInfo": "base64 인코딩 AES/CBC 암호문",
      "key": "RSA로 암호화된 AES 키 (base64)",
      "timeout": 3
    }
  },
  "verify": {
    "url": "http://sso.example.com:8000/api/verify_sso",
    "header": {
      "Content-Type": "application/json",
      "Accept": "application/json"
    },
    "body": {
      "token": {
        "json": {
          "userInfo": "{userInfo}",
          "key": "{key}"
        }
      }
    },
    "response": {
      "id": ["data.response.EP_LOGINID", "EP_LOGINID"],
      "name": ["data.response.EP_USERNAME", "EP_USERNAME"],
      "dept": ["data.response.EP_DEPTNAME", "EP_DEPTNAME"]
    },
    "etc": {
      "설명": "2단계. 서버가 1단계 값을 담아 복호화 요청을 보낸다. 서버가 RSA로 key를 풀고 AES/CBC로 userInfo를 풀어 사용자 정보를 돌려준다.",
      "url": "8000 포트만 localhost가 아니다. 실제 호스트를 적는다. 경로를 빼고 호스트만 적으면 /api/verify_sso를 붙인다.",
      "body": "요청 본문에 실을 key와 value를 그대로 적는다. \"{이름}\"은 1단계 값으로 치환되고, {\"json\": {...}}로 감싸면 그 안을 채운 뒤 JSON 문자열로 만든다.",
      "response": "응답에서 값을 꺼낼 경로. 경로 중간이 JSON 문자열이면 자동으로 객체로 바꾸고 계속 내려간다. 배열로 후보를 여러 개 줄 수 있고, 여기 적은 경로에서 못 찾으면 기본 후보(data.response.EP_* / data.EP_* / response.EP_* / userInfo.EP_* / EP_*)로 이어서 찾는다. 본문 전체가 JSON 문자열인 응답도 그대로 처리된다. id를 못 찾으면 guest로 남고 주황 LED가 켜진다.",
      "method": "POST",
      "method 설명": "405가 오면 다른 메서드로 한 번 재시도하고 로그를 남긴다.",
      "forward_headers": ["Cookie", "Authorization"],
      "timeout": 3
    }
  },
  "host": {
    "enabled": true,
    "hostname_match": "vwp",
    "userinfo_path": "/appl/CAEutil/LINUX/local/bin/userinfo/VUI_utf.txt",
    "separator": "|",
    "fields": {
      "name": 2,
      "dept": 5,
      "email": 9,
      "account": 10
    },
    "etc": {
      "설명": "폐쇄망 리눅스에서 쓰는 창구. Windows에서는 위의 local/verify(KnoxTray)를 쓰고, 여기 규칙에 걸리면 밖으로 나가지 않고 서버 안에서 신원을 정한다.",
      "hostname_match": "uname -n 에 이 문자열이 있으면 폐쇄망으로 본다. Windows에서는 이 항목과 무관하게 KnoxTray를 쓴다.",
      "판단 순서": "1) whoami 로 셸 계정을 얻는다 2) userinfo_path 파일에서 그 계정 줄을 찾아 이름·소속·EP_LOGINID를 채운다 3) 줄을 못 찾으면 셸 계정을 그대로 id로 쓴다 4) 계정조차 못 읽으면 guest로 남고 화면은 임시 로그인을 보여준다.",
      "userinfo_path": "cshell에서 grep \"|`whoami`|\" 로 찾던 그 파일. 한 줄이 123456|홍길동|... 처럼 구분자로 이어져 있다.",
      "fields": "칸 번호는 1부터 센다. email 칸의 @ 앞부분이 EP_LOGINID에 대응하는 id가 된다.",
      "account": "셸 계정은 id와 다를 수 있어 따로 보관하고, 관리자 판단(access.json의 admin.id)에서는 id와 셸 계정을 모두 맞춰 본다.",
      "enabled": "false로 두면 이 창구를 아예 쓰지 않는다."
    }
  },
  "etc": {
    "흐름 1": "브라우저가 ws://localhost:29282에 붙어 local.request를 보낸다.",
    "흐름 2": "KnoxTray 응답에서 local.response 경로로 userInfo와 key를 꺼낸다 (data가 JSON 문자열이라 자동 파싱된다).",
    "흐름 3": "그 둘을 verify.body의 token에 JSON 문자열로 담아 verify.url로 POST한다.",
    "흐름 4": "서버가 RSA 개인키로 key를 복호화하고 AES/CBC(IV=0x00*16)로 userInfo를 복호화해 사용자 정보를 돌려준다.",
    "흐름 5": "verify.response 경로로 id 이름 부서를 꺼내 화면에 표시한다. data.response도 JSON 문자열이라 자동 파싱된다.",
    "LED": "초록 = id를 가져옴 / 주황 = 통신은 됐지만 응답에서 값을 못 찾음 / 빨강 = 서비스 응답 없음",
    "로그": "각 단계가 서버 터미널에 [SSO] 접두어로, 같은 내용이 브라우저 console에 [sso]로 남는다. 자격 정보는 값 대신 길이만 표시된다.",
    "실패 시": "어떤 단계가 실패하든 id는 guest로 유지되고 다른 기능은 그대로 동작한다.",
    "설정 없을 때": "이 파일이 없거나 verify.url이 비어 있으면 SSO를 아예 시도하지 않고 LED도 켜지 않는다.",
    "환경 갈림": "Windows면 KnoxTray(local+verify), uname -n에 host.hostname_match가 있으면 서버 안에서 셸 계정으로, 둘 다 아니면 설정된 대로 verify만 시도한다. 어느 쪽도 신원을 못 얻으면 임시 로그인으로 넘어간다.",
    "poll_seconds": 30,
    "poll_seconds 설명": "화면이 SSO 상태를 다시 확인하는 주기(초). 기본 30, 최소 5.",
    "cache_seconds": 60,
    "health_seconds": 10
  }
}
